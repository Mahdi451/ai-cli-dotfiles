{
  "version": 1,
  "permissions": {
    "allow": [
      "Shell(ls)"
    ],
    "deny": []
  },
  "editor": {
    "vimMode": false
  },
  "display": {
    "showLineNumbers": false,
    "showThinkingBlocks": true,
    "showStatusIndicators": true,
    "showStatusLineRunningTime": true,
    "mode": "zen"
  },
  "notifications": true,
  "hints": true,
  "modelSlashCommands": true,
  "rewind": false,
  "exploreSubagentModel": "gpt-5.6-sol-high[fast=false]",
  "autoAcceptWebSearch": false,
  "network": {
    "useHttp1ForAgent": false
  },
  "attribution": {
    "attributeCommitsToAgent": true,
    "attributePRsToAgent": true
  },
  "statusLine": {
    "type": "command",
    "command": "python3 __CURSOR_HOME__/statusline.py",
    "padding": 0,
    "updateIntervalMs": 300,
    "timeoutMs": 2000
  },
  "model": {
    "modelId": "gpt-5.6-sol"
  },
  "selectedModel": {
    "modelId": "gpt-5.6-sol",
    "parameters": [
      {
        "id": "reasoning",
        "value": "high"
      },
      {
        "id": "fast",
        "value": "false"
      }
    ]
  },
  "approvalMode": "unrestricted",
  "sandbox": {
    "mode": "disabled",
    "networkAccess": "user_config_with_defaults"
  }
}
