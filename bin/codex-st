#!/usr/bin/env bash
set -euo pipefail

WORKFLOW_VERSION='6.0.0'
# Compatibility profile name retained so existing installs do not break solely due to a rename.
PROFILE_NAME='sol-terra-luna'
CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"

find_codex_bin() {
  local codex_bin self
  codex_bin="$(type -P codex || true)"
  self="$(readlink -f -- "$0")"
  if [[ -z "$codex_bin" ]]; then
    printf 'Codex CLI not found. Install the official codex executable first.\n' >&2
    exit 1
  fi
  if [[ "$(readlink -f -- "$codex_bin")" == "$self" ]]; then
    printf 'Refusing recursive Codex launch: codex resolves to codex-st.\n' >&2
    exit 1
  fi
  printf '%s\n' "$codex_bin"
}

show_flow() {
  cat <<EOF
Workflow version:   $WORKFLOW_VERSION
Terra parent:       gpt-5.6-terra (medium)
Luna support:       gpt-5.6-luna (medium, bounded/opportunistic)
Sol High architect: gpt-5.6-sol (high, read-only conditional)
Sol High reviewer:  gpt-5.6-sol (high, read-only conditional)
Terra High review:  gpt-5.6-terra (high, read-only optional)
Sol Max advisor:    gpt-5.6-sol (max, read-only exceptional escalation)
Profile:            $PROFILE_NAME (compatibility name)

Default flow:
  Terra inspect/plan/implement -> deterministic validation -> diff inspection -> done

Important work:
  Terra implement/validate -> Sol High targeted review -> Terra fixes -> validate -> done

Architectural work:
  Terra gathers context -> Sol High architecture -> Terra implements/validates
  -> Sol High review -> Terra fixes -> validate -> done

Luna is used only for bounded low-risk work when delegation is actually cheaper.
Sol Max is used only after credible Terra attempts and Sol High escalation leave material uncertainty.
EOF
}

doctor() {
  local path failures=0 agent
  path="$(find_codex_bin)"
  [[ -f "$CODEX_HOME/$PROFILE_NAME.config.toml" ]] || {
    printf 'Missing profile: %s\n' "$CODEX_HOME/$PROFILE_NAME.config.toml" >&2
    failures=$((failures + 1))
  }
  [[ -f "$CODEX_HOME/AGENTS.md" ]] || {
    printf 'Missing instructions: %s\n' "$CODEX_HOME/AGENTS.md" >&2
    failures=$((failures + 1))
  }
  for agent in sol-planner sol-architect sol-reviewer terra-implementer terra-reviewer luna-worker; do
    [[ -f "$CODEX_HOME/agents/$agent.toml" ]] || {
      printf 'Missing agent: %s\n' "$CODEX_HOME/agents/$agent.toml" >&2
      failures=$((failures + 1))
    }
  done
  show_flow
  if ((failures)); then
    return 1
  fi
  printf 'Codex CLI: %s\n' "$path"
  printf 'Workflow files: OK\n'
}

case "${1:-}" in
  --doctor) doctor; exit $? ;;
  --show-flow) show_flow; exit 0 ;;
esac

for arg in "$@"; do
  [[ "$arg" == -- ]] && break
  case "$arg" in
    --model|--model=*|-m|-m*)
      printf 'codex-st manages the Terra Medium parent model; do not pass --model/-m.\n' >&2
      exit 2
      ;;
    --profile|--profile=*|-p|-p*)
      printf 'codex-st manages the %s compatibility profile; do not pass --profile/-p.\n' "$PROFILE_NAME" >&2
      exit 2
      ;;
    --config|--config=*|-c|-c*|--enable|--enable=*|--disable|--disable=*)
      printf 'codex-st protects GPT Hierarchy v2; do not pass config or feature overrides.\n' >&2
      exit 2
      ;;
    --oss|--oss=*|--local-provider|--local-provider=*|--remote|--remote=*|--remote-auth-token-env|--remote-auth-token-env=*)
      printf 'codex-st protects GPT Hierarchy v2; do not pass provider or remote overrides.\n' >&2
      exit 2
      ;;
  esac
done

exec "$(find_codex_bin)" --profile "$PROFILE_NAME" "$@"
