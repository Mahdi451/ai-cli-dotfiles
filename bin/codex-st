#!/usr/bin/env bash
set -euo pipefail

WORKFLOW_VERSION='5.0.0'
PROFILE_NAME='sol-terra-luna'
CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"

find_codex_bin() {
  local codex_bin self
  codex_bin="$(type -P codex || true)"
  self="$(readlink -f -- "$0")"
  if [[ -z "$codex_bin" ]]; then
    printf 'Codex CLI not found. Install the official codex executable first.\n' >&2
    exit 1
  fi
  if [[ "$(readlink -f -- "$codex_bin")" == "$self" ]]; then
    printf 'Refusing recursive Codex launch: codex resolves to codex-st.\n' >&2
    exit 1
  fi
  printf '%s\n' "$codex_bin"
}

show_flow() {
  cat <<EOF
Workflow version:   $WORKFLOW_VERSION
Sol High parent:    gpt-5.6-sol (high)
Terra default:      gpt-5.6-terra (medium)
Luna support:       gpt-5.6-luna (medium, bounded only)
Sol Max advisor:    gpt-5.6-sol (max, read-only escalation only)
Profile:            $PROFILE_NAME

Flow:
  Sol High inspect/plan/acceptance -> Terra core implementation/tests
  -> Luna bounded support -> Terra integration/routine review
  -> Sol High complete-diff review and final signoff

  Sol Max is read-only and escalates only for architecture/security risk,
  unusually difficult reasoning, stalled debugging, or fundamental findings.
EOF
}

doctor() {
  local path failures=0 agent
  path="$(find_codex_bin)"
  [[ -f "$CODEX_HOME/$PROFILE_NAME.config.toml" ]] || {
    printf 'Missing profile: %s\n' "$CODEX_HOME/$PROFILE_NAME.config.toml" >&2
    failures=$((failures + 1))
  }
  [[ -f "$CODEX_HOME/AGENTS.md" ]] || {
    printf 'Missing instructions: %s\n' "$CODEX_HOME/AGENTS.md" >&2
    failures=$((failures + 1))
  }
  for agent in sol-planner terra-implementer terra-reviewer luna-worker; do
    [[ -f "$CODEX_HOME/agents/$agent.toml" ]] || {
      printf 'Missing agent: %s\n' "$CODEX_HOME/agents/$agent.toml" >&2
      failures=$((failures + 1))
    }
  done
  show_flow
  if ((failures)); then
    return 1
  fi
  printf 'Codex CLI: %s\n' "$path"
  printf 'Workflow files: OK\n'
}

case "${1:-}" in
  --doctor) doctor; exit $? ;;
  --show-flow) show_flow; exit 0 ;;
esac

for arg in "$@"; do
  [[ "$arg" == -- ]] && break
  case "$arg" in
    --model|--model=*|-m|-m*)
      printf 'codex-st manages the Sol High parent model; do not pass --model/-m.\n' >&2
      exit 2
      ;;
    --profile|--profile=*|-p|-p*)
      printf 'codex-st manages the %s profile; do not pass --profile/-p.\n' "$PROFILE_NAME" >&2
      exit 2
      ;;
    --config|--config=*|-c|-c*|--enable|--enable=*|--disable|--disable=*)
      printf 'codex-st protects the Sol/Terra/Luna hierarchy; do not pass config or feature overrides.\n' >&2
      exit 2
      ;;
    --oss|--oss=*|--local-provider|--local-provider=*|--remote|--remote=*|--remote-auth-token-env|--remote-auth-token-env=*)
      printf 'codex-st protects the Sol/Terra/Luna hierarchy; do not pass provider or remote overrides.\n' >&2
      exit 2
      ;;
  esac
done

exec "$(find_codex_bin)" --profile "$PROFILE_NAME" "$@"
